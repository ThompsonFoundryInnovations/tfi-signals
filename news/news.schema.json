{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signals Business News story",
  "description": "Used by news/news.json (featured, at most 5) and news/archive.json (every published story, never shrinks). The archive page combines both files and matches stories by sourceUrl.",
  "type": "object",
  "required": [
    "stories"
  ],
  "properties": {
    "updated": {
      "type": [
        "string",
        "null"
      ],
      "description": "YYYY-MM-DD date the file was last updated, or null."
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "headline",
          "category",
          "published",
          "summary",
          "whyItMatters",
          "nextStep",
          "sourceUrl",
          "lastVerified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Optional stable identifier, for example 2026-10-09-short-name."
          },
          "headline": {
            "type": "string"
          },
          "category": {
            "enum": [
              "Technology",
              "Online visibility",
              "Funding",
              "Business operations",
              "Regulatory"
            ]
          },
          "published": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string"
          },
          "whyItMatters": {
            "type": "string"
          },
          "nextStep": {
            "type": "string"
          },
          "sourceName": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https?://",
            "description": "Original source. Also used as the unique key for each story."
          },
          "lastVerified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
